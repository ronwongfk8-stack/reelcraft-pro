# GEMINI_API_KEY: Required for Gemini AI caption/script generation.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLOUD_TTS_API_KEY: Required for real AI voiceover generation.
# From Google Cloud Console: enable the "Cloud Text-to-Speech API" on your
# project, then create an API key under APIs & Services > Credentials.
# (This is a separate key from GEMINI_API_KEY — Gemini API keys from AI
# Studio are not valid for Cloud Text-to-Speech.)
GOOGLE_CLOUD_TTS_API_KEY="MY_GOOGLE_CLOUD_TTS_API_KEY"

# APP_URL: Optional override for this app's own public URL, used to build
# Stripe redirect links. If unset, falls back to Vercel's automatic
# VERCEL_URL for each deployment, or http://localhost:3000 in local dev.
APP_URL=""

# STRIPE_SECRET_KEY: Your Stripe secret key (starts with sk_test_ or sk_live_).
# Required to create Checkout Sessions. Get it from the Stripe Dashboard > Developers > API keys.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Signing secret for the /api/webhooks/stripe endpoint
# (starts with whsec_). Get it from Stripe Dashboard > Developers > Webhooks
# after adding an endpoint for https://<your-app-url>/api/webhooks/stripe
# listening for "checkout.session.completed" and "checkout.session.async_payment_succeeded".
# For local testing, run:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# which prints a temporary whsec_ value to use here.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Supabase (credits datastore) -----------------------------------------
# From the Supabase dashboard: Project Settings -> API.
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the anon/public key) — it bypasses Row
# Level Security, so it must only ever be used server-side (these /api
# functions) and must NEVER be prefixed with VITE_ or otherwise exposed to
# the browser bundle.
#
# Before running the app, execute supabase/schema.sql once against your
# project (Dashboard -> SQL Editor -> New query -> paste -> Run) to create
# the credit_accounts / stripe_processed_sessions tables and functions.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
